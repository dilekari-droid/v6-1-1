+package tr.borsatakip.v5.analysis
+
+import org.junit.Assert.*
+import org.junit.Test
+import tr.borsatakip.v5.data.ViopHistoryIntegrityPolicy
+import tr.borsatakip.v5.model.Candle
+
+class ViopScannerLiquidityIntegrationTest {
+    private fun resolve(qoi: Long?, coi: Long?) = ViopLiquidityInputPolicy.resolve(
+        quoteVolume = 10.0,
+        contractVolume = null,
+        lastClosedBarVolume = null,
+        quoteOpenInterest = qoi,
+        contractOpenInterest = coi,
+        minVolume = ViopScanner.MIN_VOLUME,
+        minOpenInterest = ViopScanner.MIN_OPEN_INTEREST
+    )
+
+    @Test fun policy_oi_availability_matches_contract_fallback_edge_case() {
+        val liquidityInputs = resolve(qoi = 0L, coi = 100L)
+        assertEquals(100L, liquidityInputs.openInterest)
+        assertTrue(liquidityInputs.openInterestAvailable)
+        assertNull(liquidityInputs.rejectCode)
+    }
+
+    @Test fun unclosed_last_bar_can_never_be_used_as_liquidity_fallback() {
+        val now = 1_700_000_000_000L
+        val openDailyBar = Candle(
+            timestamp = now - 60_000L,
+            open = 100.0,
+            high = 101.0,
+            low = 99.0,
+            close = 100.5,
+            volume = 500.0
+        )
+        assertNotNull(
+            ViopHistoryIntegrityPolicy.validateLastBarClosed(
+                candles = listOf(openDailyBar),
+                nowMs = now,
+                interval = "1d"
+            )
+        )
+    }
+}
