<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView android:id="@+id/infoTitle" style="@style/Title" />
            <TextView android:id="@+id/infoSubtitle" style="@style/Sub" android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/infoBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="5dp" />
            <Button android:id="@+id/infoAction1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone" />
            <Button android:id="@+id/infoAction2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
