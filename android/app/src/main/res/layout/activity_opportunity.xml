<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/Title" android:text="@string/auto_text_132c8ee7ac" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/auto_text_1b5bfdea22"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSortOpportunity"
                android:layout_width="118dp"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:maxLines="1"
                android:text="Sırala: Trend Gücü"
                android:textColor="@color/blue"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_card_blue"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_text_165fe10e87"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/txtMarketRegime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/auto_text_e994d8c51e"
                        android:textColor="@color/yellow"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/auto_text_a04886ca01"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BIST 100"
                        android:textColor="@color/text_muted"
                        android:textSize="8sp" />
                    <TextView
                        android:id="@+id/txtOpportunityBenchmarkValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/txtOpportunityBenchmarkChange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Veri bekleniyor"
                        android:textColor="@color/text_secondary"
                        android:textSize="8sp" />
                </LinearLayout>

                <tr.borsatakip.v5.ui.StockSparklineView
                    android:id="@+id/opportunityBenchmarkChart"
                    android:layout_width="92dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_text_25277086e8" android:textColor="@color/text_muted" android:textSize="9sp"/>
                    <TextView android:id="@+id/txtWatchedCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_text_e56aa084f4" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_text_aad4707fba" android:textColor="@color/text_muted" android:textSize="9sp"/>
                    <TextView android:id="@+id/txtFoundCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_text_e56aa084f4" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_text_5a46338ff1" android:textColor="@color/text_muted" android:textSize="9sp"/>
                    <TextView android:id="@+id/txtDataQuality" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_text_e56aa084f4" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fillViewport="false"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/btnFilterAll" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="70dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="12dp" android:maxLines="1" android:text="@string/auto_text_a39264d52a" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/btnFilterStrongBuy" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="90dp" android:layout_marginStart="5dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="12dp" android:maxLines="1" android:text="LONG" android:textColor="@color/green" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/btnFilterStrongSell" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="90dp" android:layout_marginStart="5dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="12dp" android:maxLines="1" android:text="SHORT" android:textColor="@color/red" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/btnFilterWatch" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="82dp" android:layout_marginStart="5dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="12dp" android:maxLines="1" android:text="@string/auto_text_0d3df47fea" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/btnFilterStrongLong" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="104dp" android:layout_marginStart="5dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="12dp" android:maxLines="1" android:text="Güçlü LONG" android:textColor="@color/green_strong" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/btnFilterStrongShort" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="108dp" android:layout_marginStart="5dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="12dp" android:maxLines="1" android:text="Güçlü SHORT" android:textColor="@color/red_strong" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/btnFilterInsufficient" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="110dp" android:layout_marginStart="5dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="12dp" android:maxLines="1" android:text="Yetersiz Veri" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/btnFilterRejected" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="92dp" android:layout_marginStart="5dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="12dp" android:maxLines="1" android:text="Reddedildi" android:textColor="@color/red" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/btnFilterCatalyst" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="100dp" android:layout_marginStart="5dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="12dp" android:maxLines="1" android:text="@string/auto_text_f19347f99e" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/btnFilterLowRisk" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="94dp" android:layout_marginStart="5dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="12dp" android:maxLines="1" android:text="@string/auto_text_fb77e3b730" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/btnFilterHighVolume" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="104dp" android:layout_marginStart="5dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="12dp" android:maxLines="1" android:text="@string/auto_text_f9263ab392" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold"/>
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/txtSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/auto_text_e3ebddd111"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRealOpportunityScan"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_blue"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:text="@string/auto_text_4f8b843eb6"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSignalHistory"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/auto_text_d3be8da608"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp" />

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
