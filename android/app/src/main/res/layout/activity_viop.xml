<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <!-- Header: title is isolated from status chips so VİOP can never wrap as VİO / P. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="VİOP"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Borsa İstanbul Vadeli İşlem Kontratları"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/openFavorites"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Favoriler"
                android:gravity="center"
                android:text="☆"
                android:textColor="@color/blue"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/openSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Ayarlar"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/text_secondary"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/openNotifications"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Bildirimler"
                android:gravity="center"
                android:text="●"
                android:textColor="@color/red"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Provider state is a separate full-width row. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_card_blue"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/providerDot"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="●"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/providerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="VİOP VERİ SERVİSİ KONTROL EDİLİYOR"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/providerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Veri kaynağı kontrol ediliyor"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <Button
                android:id="@+id/refresh"
                style="@style/ScanFilterButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:minWidth="72dp"
                android:paddingHorizontal="8dp"
                android:text="Yenile"
                android:textAllCaps="false"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Mode cards: production publication and underlying bias are explicitly separated. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/modeProduction"
                android:contentDescription="Gerçek VİOP taraması"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:maxLines="2"
                android:padding="6dp"
                android:text="GERÇEK VİOP TARAMASI\nVeri servisi gerekli"
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modeUnderlying"
                android:contentDescription="Dayanak ön tarama, VİOP sinyali değildir"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:maxLines="2"
                android:padding="6dp"
                android:text="DAYANAK ÖN TARAMA\nVİOP sinyali değildir"
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/scopeNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip"
            android:padding="7dp"
            android:text="Doğrulanmış vadeli işlem kontratları. Opsiyon analizi mevcut kapsamda yayımlanmaz."
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />

        <!-- Four mathematically consistent counters. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/summaryLong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="3"
                android:text="VİOP LONG\n0"
                android:textAlignment="center"
                android:textColor="@color/green"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summaryShort"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="3"
                android:text="VİOP SHORT\n0"
                android:textAlignment="center"
                android:textColor="@color/red"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summaryWatch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="3"
                android:text="İZLE\n0"
                android:textAlignment="center"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summaryTotal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="3"
                android:text="TARANAN\n0"
                android:textAlignment="center"
                android:textColor="@color/blue"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dayanak Varlıklar (Son Durum)"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_market_tile"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BIST 30" android:textColor="@color/text_secondary" android:textSize="8sp" />
                    <TextView android:id="@+id/viopUnderlyingBist30Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/viopUnderlyingBist30Change" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="Veri bekleniyor" android:textColor="@color/text_secondary" android:textSize="7sp" />
                    <tr.borsatakip.v5.ui.StockSparklineView android:id="@+id/viopUnderlyingBist30Chart" android:layout_width="match_parent" android:layout_height="22dp" android:layout_marginTop="1dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_market_tile"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BIST 100" android:textColor="@color/text_secondary" android:textSize="8sp" />
                    <TextView android:id="@+id/viopUnderlyingBist100Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/viopUnderlyingBist100Change" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="Veri bekleniyor" android:textColor="@color/text_secondary" android:textSize="7sp" />
                    <tr.borsatakip.v5.ui.StockSparklineView android:id="@+id/viopUnderlyingBist100Chart" android:layout_width="match_parent" android:layout_height="22dp" android:layout_marginTop="1dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_market_tile"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DOLAR/TL" android:textColor="@color/text_secondary" android:textSize="8sp" />
                    <TextView android:id="@+id/viopUnderlyingUsdTryValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="—" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/viopUnderlyingUsdTryStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:text="Doğrulanmış kaynak yok" android:textColor="@color/text_secondary" android:textSize="7sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_market_tile"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALTIN" android:textColor="@color/text_secondary" android:textSize="8sp" />
                    <TextView android:id="@+id/viopUnderlyingGoldValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="—" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/viopUnderlyingGoldStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:text="Doğrulanmış kaynak yok" android:textColor="@color/text_secondary" android:textSize="7sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/signalSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:text="Henüz tarama sonucu yok"
                android:textColor="@color/text_secondary"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/watchlistBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ İzleme 0"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/signalLastUpdate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:maxLines="2"
                    android:text="Veri — • Alım — • Tarama —"
                    android:textColor="@color/text_secondary"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/viopSearch"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Sembol, dayanak veya kontrat ara..."
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="11sp" />

            <Button
                android:id="@+id/sortMode"
                style="@style/ScanFilterButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="5dp"
                android:minHeight="48dp"
                android:text="Sırala: Ranking"
                android:textAllCaps="false"
                android:textSize="9sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/filterAll" style="@style/ScanFilterButton" android:layout_height="48dp" android:minHeight="48dp" android:text="TÜMÜ" />
                <Button android:id="@+id/filterLong" style="@style/ScanFilterButton" android:layout_height="48dp" android:minHeight="48dp" android:layout_marginStart="4dp" android:text="LONG" />
                <Button android:id="@+id/filterShort" style="@style/ScanFilterButton" android:layout_height="48dp" android:minHeight="48dp" android:layout_marginStart="4dp" android:text="SHORT" />
                <Button android:id="@+id/filterWatch" style="@style/ScanFilterButton" android:layout_height="48dp" android:minHeight="48dp" android:layout_marginStart="4dp" android:text="İZLE" />
                <Button android:id="@+id/detailedFilter" style="@style/ScanFilterButton" android:layout_height="48dp" android:minHeight="48dp" android:layout_marginStart="8dp" android:text="Detaylı Filtre" android:textAllCaps="false" />
            </LinearLayout>
        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/advancedFilterRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/filterIndex" style="@style/ScanFilterButton" android:layout_height="48dp" android:minHeight="48dp" android:text="Endeks" />
                <Button android:id="@+id/filterEquity" style="@style/ScanFilterButton" android:layout_height="48dp" android:minHeight="48dp" android:layout_marginStart="4dp" android:text="Pay" />
                <Button android:id="@+id/filterFx" style="@style/ScanFilterButton" android:layout_height="48dp" android:minHeight="48dp" android:layout_marginStart="4dp" android:text="Döviz" />
                <Button android:id="@+id/filterCommodity" style="@style/ScanFilterButton" android:layout_height="48dp" android:minHeight="48dp" android:layout_marginStart="4dp" android:text="Emtia" />
                <Button android:id="@+id/filterRate" style="@style/ScanFilterButton" android:layout_height="48dp" android:minHeight="48dp" android:layout_marginStart="4dp" android:text="Faiz" />
                <Button style="@style/ScanFilterButton" android:layout_height="40dp" android:minHeight="40dp" android:layout_marginStart="4dp" android:enabled="false" android:text="Opsiyon: kapsam dışı" android:textAllCaps="false" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button android:id="@+id/openContracts" style="@style/ScanFilterButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minHeight="48dp" android:text="Kontratlar" />
            <Button android:id="@+id/openAnalysis" style="@style/ScanFilterButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="4dp" android:minHeight="48dp" android:text="Analiz" />
            <Button android:id="@+id/openSignals" style="@style/ScanFilterButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="4dp" android:minHeight="48dp" android:text="Sinyaller" />
            <Button android:id="@+id/openExpiries" style="@style/ScanFilterButton" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:text="Vadeler" />
        </LinearLayout>
    </LinearLayout>

    <!-- Only this RecyclerView scrolls. No ScrollView + RecyclerView nesting. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/emptySignals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="Sonuç bulunamadı"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_card"
        android:ellipsize="end"
        android:maxLines="3"
        android:padding="8dp"
        android:text="VİOP durumu hazırlanıyor"
        android:textColor="@color/text_secondary"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/viopInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/bg_card_blue"
        android:maxLines="2"
        android:padding="7dp"
        android:text="VİOP Taraması Hakkında • Yalnız VALID vadeli kontratlar analiz/yayın kapısına girer. Evren, analiz, yetersiz, red ve veri-yok sayıları ayrı tutulur."
        android:textColor="@color/text_secondary"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/viopWarningCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_card"
        android:maxLines="2"
        android:padding="7dp"
        android:text="Önemli Uyarı • Bu ekran yatırım tavsiyesi değildir. Dayanak teknik eğilimi gerçek VİOP işlem sinyali değildir; doğrulanamayan veri fail-closed olarak yayımlanmaz."
        android:textColor="@color/text_muted"
        android:textSize="8sp" />

    <!-- Compatibility IDs used by verified preview logic; intentionally hidden. -->
    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:orientation="vertical">
        <TextView android:id="@+id/providerLastUpdate" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/providerDataAge" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/providerLatency" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/heroTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/heroContract" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/heroExpiry" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/heroPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/heroChange" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <tr.borsatakip.v5.ui.ViopSparklineView android:id="@+id/heroSparkline" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/metricOpen" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/metricHigh" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/metricLow" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/metricBid" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/metricAsk" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/metricVolume" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/metricOi" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/metricBasis" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/marketContracts" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/marketSignals" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/marketTrend" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <include layout="@layout/include_viop_bottom_nav" />
</LinearLayout>
