<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="7dp"
    android:background="@drawable/bg_card"
    android:minHeight="126dp"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:minWidth="106dp"
            android:orientation="vertical"
            android:paddingEnd="5dp">

            <TextView
                android:id="@+id/viopDirection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="@color/green"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/viopSymbol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:breakStrategy="simple"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/viopSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="3"
                android:textColor="@color/text_secondary"
                android:textSize="9sp" />
        </LinearLayout>

        <tr.borsatakip.v5.ui.ViopSparklineView
            android:id="@+id/viopMiniChart"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="0.9"
            android:minWidth="74dp"
            android:padding="2dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.95"
            android:gravity="end"
            android:orientation="vertical"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/viopPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/viopChange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/viopClass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/viopFavorite"
            android:layout_width="32dp"
            android:layout_height="64dp"
            android:contentDescription="VİOP favori"
            android:gravity="center"
            android:text="☆"
            android:textColor="@color/blue"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/viopDetailButton"
            android:layout_width="28dp"
            android:layout_height="64dp"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/text_primary"
            android:textSize="27sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/viopScores"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="3"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/viopLevels"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1.2"
            android:gravity="end"
            android:maxLines="3"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/viopReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_muted"
        android:textSize="8.5sp" />
</LinearLayout>
